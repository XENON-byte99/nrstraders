# Copy to .env on the server and fill in. Never commit the real .env.

# ── Claude (AI order assistant) ── console.anthropic.com → API keys
ANTHROPIC_API_KEY=PASTE-YOUR-ANTHROPIC-API-KEY-HERE
AI_MODEL=claude-opus-5-5

# ── WhatsApp Business Platform ── developers.facebook.com → your app → WhatsApp
WHATSAPP_TOKEN=PASTE-HERE
WHATSAPP_PHONE_NUMBER_ID=PASTE-HERE
WHATSAPP_APP_SECRET=PASTE-HERE
WHATSAPP_VERIFY_TOKEN=PASTE-HERE
WHATSAPP_API_VERSION=v23.0
# Your own WhatsApp number (questions and alerts from the assistant come here)
OWNER_WHATSAPP=PASTE-HERE

# ── Autopilot (messages that go out without your approval) ──
AUTOPILOT_ENABLED=False
AUTOPILOT_MAX_TOTAL=50000
AUTOPILOT_TRUSTED_AFTER=3
# Leave empty for no quiet hours (also switchable in the app)
QUIET_HOURS=

# Template sent automatically when more than 24 hours have passed since the
# client's last message (WhatsApp rule). Variables: {{1}} name, {{2}} order/bill no.
WHATSAPP_REOPEN_TEMPLATE=PASTE-HERE
WHATSAPP_TEMPLATE_LANGUAGE=en

# Public address of the site (the server opens its own print pages to make PDFs)
SITE_URL=https://nrs.firebaseit.com

# Shown on the AI costs page
USD_TO_BDT=122
